# Copy to .env for local development:  cp .env.example .env

# Postgres. Local: the Docker container from docker-compose.yml.
# Neon later: use the *pooled* connection string, e.g. postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/petcare?sslmode=require
DATABASE_URL=postgres://petcare:petcare@localhost:5434/petcare

# Better Auth. Generate a secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
# The public URL of the app (where /api/auth lives).
BETTER_AUTH_URL=http://localhost:5173

# Allow new accounts to sign up. Set to false in production once your own account exists.
ALLOW_SIGNUP=true

# Test-only routes (/api/dev/*) that create seeded demo sessions for Playwright.
# Never enable in production. They are also refused when VERCEL_ENV=production.
ENABLE_TEST_ROUTES=true

# File storage for photos and receipts: "local" (disk, for development) or "vercel-blob" (later).
STORAGE_DRIVER=local
UPLOAD_DIR=.data/uploads
# Needed only when STORAGE_DRIVER=vercel-blob:
# BLOB_READ_WRITE_TOKEN=
